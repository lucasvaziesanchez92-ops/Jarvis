FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential gcc g++ \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    langgraph-prebuilt==1.0.13 \
    langgraph==1.1.10 \
    langgraph-checkpoint==4.0.3 \
    langgraph-sdk==0.3.13 \
    langchain==1.2.14 \
    langchain-core==1.3.2 \
    langchain-ollama==1.0.1 \
    langchain-openai==1.1.11

COPY requirements.railway.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./backend/
COPY main.py knowledge_engine.py librarian.py sync_service.py alembic.ini ./
COPY web-next/public/models/brain.stl ./data/

RUN mkdir -p /app/data && chown -R 1000:1000 /app/data

RUN addgroup --system app && adduser --system --group app
USER app

EXPOSE 8000

CMD python -m uvicorn backend.api.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1 --timeout-keep-alive 120
